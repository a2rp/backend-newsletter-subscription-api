@baseUrl = http://localhost:1198

### API status
GET {{baseUrl}}/

### Health
GET {{baseUrl}}/health

### Register admin
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
x-admin-registration-secret: {{$dotenv ADMIN_REGISTRATION_SECRET}}

{
  "name": "Admin User",
  "email": "admin@example.com",
  "password": "ReplaceThisWithYourOwnPassphrase2026!"
}

### Login admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "ReplaceThisWithYourOwnPassphrase2026!"
}

### Subscribe
POST {{baseUrl}}/api/newsletter/subscribe
Content-Type: application/json

{
  "email": "subscriber@example.com"
}

### Unsubscribe
POST {{baseUrl}}/api/newsletter/unsubscribe
Content-Type: application/json

{
  "email": "subscriber@example.com",
  "token": "REPLACE_WITH_SIGNED_EMAIL_TOKEN"
}

### Active subscribers (admin cookie required)
GET {{baseUrl}}/api/newsletter/subscribers

### Logout admin
POST {{baseUrl}}/api/auth/logout
